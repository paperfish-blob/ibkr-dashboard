# Copy to .env and fill in. .env is gitignored -- the Flex token is a credential.

# --- Flex Web Service (historical realized P&L) ---
# Client Portal -> Settings -> Account Settings -> Flex Web Service
FLEX_TOKEN=
# Client Portal -> Performance & Reports -> Flex Queries -> your query's ID
FLEX_QUERY_ID=

# Seconds before the cached statement is refetched.
# The token allows 1 request/second and 10/minute, so keep this generous.
FLEX_CACHE_TTL_SECONDS=900

# --- IB Gateway (today's live realized P&L) ---
IB_HOST=127.0.0.1
# 4001 = live, 4002 = paper
IB_PORT=4001
IB_CLIENT_ID=17
# Leave blank to use the first account IB Gateway reports.
IB_ACCOUNT=
IB_RECONNECT_SECONDS=30
